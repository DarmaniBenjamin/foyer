# Settings for running Foyer on your own computer: copy this file to
# .env (in the same folder) and fill it in. .env is never put on GitHub.
# On SiteGround, put the same settings in Site Tools -> Node.js ->
# Environment variables instead.

# HOSTING=siteground

# The PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foyer_db
DB_USER=foyer
DB_PASSWORD=change-me

# A long random code you make up: open /setup/<this code> once to make
# the first admin
SETUP_CODE=

# Locks the controller passwords in the database. Make one with:
#   openssl rand -base64 32
# and keep a copy somewhere safe. (Optional on your own computer.)
SECRET_KEY=

# Shows why the database isn't working on the page itself (setup only)
# SHOW_ERRORS=on
